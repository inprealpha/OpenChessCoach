 "intro": {
  "text": "Rook and pawn against rook is the most common endgame of all, and two positions are the key to it. With the Lucena position the side with the pawn wins by building a bridge with the rook to shelter its king. With the Philidor position the defender draws by keeping the rook on the third rank and then checking from behind.",
  "credit": {
   "source": "Wikipedia, Lucena position",
   "url": "https://en.wikipedia.org/wiki/Lucena_position",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikipedia contributors (see the page history)"
  }
 },
