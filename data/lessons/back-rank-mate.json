{
 "id": "back-rank-mate",
 "name": "Back-rank mate",
 "kind": "theme",
 "track": "themes",
 "level": "beginner",
 "goal": "You can mate a king trapped behind its own pawns on the back rank, and give your own king an escape square in time.",
 "priorKnowledge": [
  "mate-in-one"
 ],
 "side": "white",
 "puzzleTags": [],
 "puzzleThemes": [
  "backRankMate"
 ],
 "intro": {
  "text": "A back-rank mate is delivered by a rook or queen along the last rank, when the king cannot step forward because its own pawns block the way. The defending rook or queen that guards the back rank can often be lured away, exchanged or simply overloaded. To guard against it, give your king a flight square by moving one of the pawns in front of it.",
  "credit": {
   "source": "Wikipedia, Back-rank checkmate",
   "url": "https://en.wikipedia.org/wiki/Back-rank_checkmate",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikipedia contributors (see the page history)"
  }
 },
