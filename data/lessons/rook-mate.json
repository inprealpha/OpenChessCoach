{
 "id": "rook-mate",
 "name": "Mate with king and rook",
 "kind": "endgame",
 "side": "white",
 "puzzleTags": [],
 "puzzleThemes": [],
 "intro": {
  "text": "Mating with king and rook takes longer than with a queen, because king and rook must work together. The usual method is to build a box with the rook, protected by your own king, and make it smaller and smaller until the enemy king is pushed into a corner. No checks are needed until the final mate.",
  "credit": {
   "source": "Wikibooks, Chess/The Endgame/King and Rook vs. King",
   "url": "https://en.wikibooks.org/wiki/Chess/The_Endgame/King_and_Rook_vs._King",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikibooks contributors (see the page history)"
  }
 },
