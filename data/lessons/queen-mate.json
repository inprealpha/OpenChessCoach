  "mate-in-one"
 ],
 "side": "white",
 "puzzleTags": [],
 "puzzleThemes": [],
 "intro": {
  "text": "Mating with king and queen against a lone king is easy once you know the method: use the queen alone to drive the enemy king to the edge of the board, keeping the queen a knight's move away from it, with no checks needed. Then bring your own king up to help, and watch out for stalemate. It takes about ten to fifteen moves.",
  "credit": {
   "source": "Wikibooks, Chess/The Endgame/King and Queen vs. King",
   "url": "https://en.wikibooks.org/wiki/Chess/The_Endgame/King_and_Queen_vs._King",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikibooks contributors (see the page history)"
  }
 },
