{
 "id": "king-and-pawn",
 "name": "King and pawn endgames",
 "kind": "endgame",
 "track": "endgames",
 "level": "intermediate",
 "goal": "You can tell whether king and pawn win against a lone king, using the opposition and the key squares in front of the pawn.",
 "priorKnowledge": [
  "active-king"
 ],
 "side": "white",
 "puzzleTags": [],
 "puzzleThemes": [
  "pawnEndgame"
 ],
 "intro": {
  "text": "Two ideas decide most endgames with only kings and pawns: the rule of the square, which tells you whether a king can catch a pawn, and the opposition, the stand-off between two kings with one square between them. A passed pawn far from the other pawns, an outside passed pawn, is often enough to win.",
  "credit": {
   "source": "Wikibooks, Chess/The Endgame/Pawn Endings",
   "url": "https://en.wikibooks.org/wiki/Chess/The_Endgame/Pawn_Endings",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikibooks contributors (see the page history)"
  }
 },
