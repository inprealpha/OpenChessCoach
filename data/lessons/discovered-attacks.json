 "intro": {
  "text": "A discovered attack happens when one piece moves out of the way and uncovers an attack by another piece behind it. Two pieces can then threaten at once. When the uncovered attack is a check it is a discovered check, and when the moving piece gives check as well it is a double check: the king must move, because two checks cannot both be blocked or captured.",
  "credit": {
   "source": "Wikibooks, Chess/Tactics",
   "url": "https://en.wikibooks.org/wiki/Chess/Tactics",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikibooks contributors (see the page history)"
  }
 },
