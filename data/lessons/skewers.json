 "intro": {
  "text": "A skewer is a pin turned around. In a pin the less valuable piece stands in front of the more valuable one; in a skewer the more valuable piece is attacked first, and when it moves away the piece behind it is lost. Skewers through the king are the strongest, because the king must move.",
  "credit": {
   "source": "Wikibooks, Chess/Tactics",
   "url": "https://en.wikibooks.org/wiki/Chess/Tactics",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikibooks contributors (see the page history)"
  }
 },
