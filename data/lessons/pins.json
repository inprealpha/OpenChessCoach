 "intro": {
  "text": "A pinned piece cannot move without exposing a more valuable piece behind it. In an absolute pin the piece behind is the king, so moving the pinned piece is illegal. In a relative pin the piece behind is a queen or rook: the pinned piece may move, but it costs material. Once you have pinned a piece, look for a way to attack it again: it cannot run away.",
  "credit": {
   "source": "Wikibooks, Chess/Tactics",
   "url": "https://en.wikibooks.org/wiki/Chess/Tactics",
   "licence": "CC BY-SA 4.0",
   "licenceUrl": "https://creativecommons.org/licenses/by-sa/4.0/",
   "authors": "Wikibooks contributors (see the page history)"
  }
 },
 "parts": [
  {
   "title": "Attack the pinned piece",
   "fen": "6k1/pp1n1rpp/2p5/8/2BP4/5N2/P4PPP/6K1 w - - 0 1",
   "side": "white",
   "keyIdea": "",
   "text": "Your bishop pins Black's rook on f7 to the king on g8. You could take the rook at once, but there is something stronger.",
   "textCredit": {
    "source": "Wikibooks, Chess/Tactics",
    "url": "https://en.wikibooks.org/wiki/Chess/Tactics",
    "licence": "CC BY-SA 4.0",
